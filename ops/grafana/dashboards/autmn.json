{
  "uid": "autmn-pipeline",
  "title": "Autmn \u2014 queues and pipeline",
  "tags": [
    "autmn"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue depth",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "autmn_queue_depth{state=\"waiting\"}",
          "legendFormat": "{{queue}} waiting",
          "refId": "A"
        },
        {
          "expr": "autmn_queue_depth{state=\"active\"}",
          "legendFormat": "{{queue}} active",
          "refId": "B"
        },
        {
          "expr": "autmn_queue_depth{state=\"delayed\"}",
          "legendFormat": "{{queue}} delayed",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "The first thing that moves when something upstream breaks. Image jobs take minutes and run three at a time, so waiting climbing while active sits flat means the workers are wedged, not busy."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Failed jobs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "autmn_queue_depth{state=\"failed\"}",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Retained failures, not a rate. BullMQ keeps the last 2000, so this is a standing backlog to drain rather than a spike to alert on."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Job duration (p50 / p95)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(autmn_job_duration_seconds_bucket[5m])) by (le, queue))",
          "legendFormat": "{{queue}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(autmn_job_duration_seconds_bucket[5m])) by (le, queue))",
          "legendFormat": "{{queue}} p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Buckets run to 15 minutes because a single image can take seven through the full generation pipeline."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Job throughput",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(autmn_jobs_total[5m])) by (queue, outcome)",
          "legendFormat": "{{queue}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "description": "Completions and failures per second. Failures rising while completions hold usually means one AI provider is degraded, not the pipeline."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API request latency (p95)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(autmn_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "The WhatsApp webhook is the one that matters: Meta retries and eventually backs off if acknowledgement is slow."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Event loop lag (p99)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_p99_seconds",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Included because this codebase ran tight pixel loops on the loop. Lag here is how CPU-bound work in an async process shows up before users notice anything."
    }
  ]
}
