# =============================================================================
# Autmn — .env.example
# Copy to .env, fill in values, restart the worker + API.
# Plural _KEYS vars (comma-separated) override singular when both are set.
# =============================================================================

# ---- Required: WhatsApp Cloud API ------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# ---- Required: AI providers -------------------------------------------------
# Gemini — primary image gen (Tier 1: gemini-3-pro-image-preview) and all
# Flash usage (Light Analyzer, Creative Brief, Verifier, parsers). Get 3+
# keys before launch to absorb rate limits during traffic spikes; the keypool
# rotates automatically.
GEMINI_API_KEY=
# GEMINI_API_KEYS=k1,k2,k3   # plural form, comma-separated, overrides singular
# Legacy aliases still honoured by keypool for backwards compat — DO NOT add
# new code paths against them:
#   GOOGLE_AI_API_KEY / GOOGLE_AI_API_KEYS / GOOGLE_GENAI_API_KEY

# OpenAI — Tier 2 fallback only (gpt-image-2 / dall-e-3). Fires only on
# Gemini hard safety refusal; lower volume, but still get 2 keys.
OPENAI_API_KEY=
# OPENAI_API_KEYS=k1,k2

# fal.ai — strict track (BiRefNet segmentation + Flux inpainting).
FAL_KEY=
# FAL_KEYS=k1,k2

# Groq — voice transcription via Whisper Turbo. Free tier fits launch volume.
GROQ_API_KEY=
# GROQ_API_KEYS=k1,k2

# Sarvam — optional Hindi voice fallback.
SARVAM_API_KEY=
# SARVAM_API_KEYS=k1

# ---- Required: payments -----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Where Razorpay redirects after a UPI payment completes; should hit the API
# host that serves /webhooks/razorpay/payment-complete.
# RAZORPAY_CALLBACK_URL=https://api.autmn.app/webhooks/razorpay/payment-complete

# ---- Required: persistence + infra -----------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Upstash Redis (BullMQ).
REDIS_URL=

# ---- Required: ops ----------------------------------------------------------
# x-admin-secret header for /admin/* in production. Generate with:
#   openssl rand -hex 32
ADMIN_SECRET=

# Sentry (errors + alerts).
SENTRY_DSN=

# ---- Required: refund flow (Phase 15a-c) -----------------------------------
# Resend — transactional email for founder refund-request notifications.
RESEND_API_KEY=
ADMIN_EMAIL=                         # Where refund-request emails land.
# FROM_EMAIL='Autmn <noreply@autmn.app>'   # defaults if unset; domain must be verified.

# Refund decision tokens (JWT signing). Must be ≥32 chars. Rotating it
# invalidates every outstanding email; on rotation, decide pending refunds via SQL.
REFUND_DECISION_SECRET=

# Phone number a denied user is directed to for contesting (human-staffed,
# not the bot). E.164 format. If unset, the contact section is omitted.
# SUPPORT_PHONE_NUMBER=+919876543210

# ---- App basics -------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_URL=http://localhost:3000   # used to build refund magic links

# ---- Phase 3b — brand analysis ---------------------------------------------
BRAND_SCRAPE_TIMEOUT_MS=30000
# BRAND_ANALYSIS_DRY_RUN=true  # smoke-only — skip Gemini / Playwright / pdf-parse

# ---- Phase 5 — brand-context injection -------------------------------------
# INCLUDE_BRAND_CONTEXT=false  # A/B kill switch — disable brand-context in prompts

# ---- Phase 9 — WhatsApp Flows (dormant by default) -------------------------
# WHATSAPP_FLOWS_ENABLED=true
# WHATSAPP_STYLE_PICKER_FLOW_ID=<from Meta Business Manager dashboard>
# WHATSAPP_STYLE_PICKER_FLOW_MODE=published   # or 'draft' during testing

# ---- Dev-only escape hatches (NEVER set in production) ---------------------
# PAYMENT_BYPASS=true   # NEVER commit. Use shell export only: export PAYMENT_BYPASS=true
